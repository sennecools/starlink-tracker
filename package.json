{
  "name": "starlink-tracker",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "dev:offline": "node --env-file=scripts/offline.env node_modules/vite/bin/vite.js",
    "build": "tsc --noEmit && vite build",
    "snapshot": "node scripts/snapshot-elements.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "type": "module",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sarap422/font-d-din": "^1.0.6",
    "cesium": "^1.147.0",
    "satellite.js": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "d3-celestial": "^0.7.35",
    "gltf-validator": "^2.0.0-dev.3.10",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "private": true
}
